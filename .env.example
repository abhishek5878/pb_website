# /tend, the publishing room. Names only; set the values in Vercel (and a local .env, never committed).
# docs/design/tend-spec.md, "Infra".

# Fine-grained GitHub PAT: Contents read/write on pb_website only.
GITHUB_TOKEN=
GITHUB_REPO=abhishek5878/pb_website
GITHUB_BRANCH=main

# The passphrase that opens /tend, and 32+ random bytes that sign its session cookie.
TEND_PASSPHRASE=
TEND_SECRET=

# The daily rebuild: Vercel's cron calls /api/rebuild/ with `Authorization: Bearer $CRON_SECRET`,
# which POSTs to the deploy hook so the feeds (Letterboxd, Substack) refresh.
DEPLOY_HOOK_URL=
CRON_SECRET=

# Local only: with TEND_MOCK=1, saves write to the working tree instead of GitHub.
# TEND_MOCK=1
