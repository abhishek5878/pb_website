---
/**
 * One project. docs/design/work-pages.md is the contract; the reading system
 * (docs/design/reading.md) sets the column and the type.
 *
 * The name you clicked on /work/ is the name you land on, at the same size.
 * Under it the slate: status (the ledger's dot), when, tags. Then the piece in
 * the reading column, the links (kind small on the left, the place on the
 * right), the screenshots in a hairline frame, why it stopped where the
 * evidence says, and the next project along the ledger.
 *
 * A project without a `work` entry still gets a page, honest and small: only
 * what projects.json holds. /work/ doesn't link to it until the entry lands.
 */
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import type { Project } from '../../data/me';
import { iso } from '../../lib/posts';
import { sortedProjects, workEntries, pagePath, isRunning, whenISO, type WorkEntry } from './_work';
import Ending from '../../components/Ending.astro';
import { threadsOf, mentionsOf, addedOn, after, statusGroup } from '../../lib/endings';

export async function getStaticPaths() {
  const list = sortedProjects();
  const entries = await workEntries();
  /* Newer / older walk the ledger within the project's status group, only through projects with a page worth reading. */
  const nearest = (from: number, step: 1 | -1) => {
    const g = statusGroup(list[from]);
    for (let j = from + step; j >= 0 && j < list.length; j += step) if (statusGroup(list[j]) === g && entries.has(list[j].slug)) return list[j];
    return null;
  };
  return list.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, entry: entries.get(project.slug) ?? null, prev: nearest(i, -1), next: nearest(i, 1) },
  }));
}

interface Props {
  project: Project;
  entry: WorkEntry | null;
  prev: Project | null;
  next: Project | null;
}
const { project: p, entry, prev, next } = Astro.props;
const d = entry?.data;
const summary = d?.summary ?? p.line;
const run = isRunning(p);
const hasBody = !!entry?.body?.trim();
const { Content } = hasBody && entry ? await render(entry) : { Content: null };

/* No entry yet: the one link projects.json may hold. Its kind is read off the address. */
const links = d
  ? d.links
  : p.href
    ? [{ label: p.href.replace(/^https?:\/\//, '').replace(/\/$/, ''), url: p.href, kind: /github\.com\//.test(p.href) ? 'repo' : 'page' }]
    : [];
const examples = d?.examples ?? [];
const host = (u: string) => u.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const stoppedLabel = p.status === 'paused' ? 'Why it paused' : 'Why it stopped';

/* ---- the end (src/components/Ending.astro): the thread, who links here, the dates, the group's pair ---- */
const threads = await threadsOf({ project: p.slug });
const mentions = await mentionsOf({ project: p.slug });
/* written: the day the page landed here (git; unknown in a shallow clone); changed: its `updated` */
const written = addedOn(entry?.filePath);
const changed = d?.updated && (!written || after(d.updated, written)) ? d.updated : undefined;
const neighbour = (x: Project | null) => (x ? { title: x.name, href: pagePath(x.slug), date: x.when, datetime: whenISO(x.when) } : null);
const group = `, also ${statusGroup(p)}`;

/* For agents: the project, with when it started and when the page last changed. */
const SITE = 'https://vyas.garden';
const work = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: p.name,
  description: summary,
  url: new URL(pagePath(p.slug), SITE).href,
  dateCreated: whenISO(p.when),
  ...(d?.updated ? { dateModified: iso(d.updated) } : {}),
  creativeWorkStatus: p.status,
  keywords: p.tags.join(', '),
  author: { '@type': 'Person', name: 'Abhishek Vyas', url: SITE + '/' },
  ...(links.length ? { sameAs: links.map((l) => l.url) } : {}),
};
---

<Base title={p.name} description={summary}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(work)} />
  <article class:list={['wrap room', { bare: !Content }]} data-status={p.status} data-run={run ? '' : undefined}>
    <header class="head col">
      <p class="back small"><a href={`/work/#${p.slug}`} class="quiet">Work</a></p>
      <h1 class="name">{p.name}</h1>
      <p class="summary">{summary}</p>
      {!entry && p.why && <p class="why small">{p.why}</p>}
      <p class="slate small">
        <span class="status">
          {(run || p.status === 'paused') && <span class="dot" aria-hidden="true"></span>}
          {p.status}
        </span>
        <time class="mono" datetime={whenISO(p.when)}>{p.when}</time>
        {p.tags.length > 0 && <span class="tags">{p.tags.join(', ')}</span>}
      </p>
    </header>

    {Content && (
      <div class="body">
        <Content />
      </div>
    )}

    {links.length > 0 && (
      <section class="links col" aria-labelledby="links-label">
        <h2 id="links-label" class="small label">{links.length === 1 ? 'Link' : 'Links'}</h2>
        <ul role="list">
          {links.map((l) => (
            <li>
              <span class="kind small">{l.kind}</span>
              <a href={l.url} rel="external">{l.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {examples.length > 0 && (
      <section class="examples" aria-label="Examples">
        {examples.map((ex) => (
          <figure class="shot">
            <div class="frame">
              <Image
                src={ex.src}
                alt={ex.caption}
                widths={[880, 1320, 1760]}
                sizes="(max-width: 959px) calc(100vw - 2.5rem), 880px"
                loading="lazy"
                decoding="async"
              />
            </div>
            <figcaption class="small">
              {ex.caption}
              {ex.url && <a href={ex.url} rel="external" class="src">{host(ex.url)}</a>}
            </figcaption>
          </figure>
        ))}
      </section>
    )}

    {d?.stopped && (
      <aside class="stopped col" aria-labelledby="stopped-label">
        <h2 id="stopped-label" class="small label">{stoppedLabel}</h2>
        <p>{d.stopped}</p>
      </aside>
    )}
  </article>

  <Ending
    written={written}
    changed={changed}
    threads={threads}
    mentions={mentions}
    newer={neighbour(prev)}
    older={neighbour(next)}
    group={group}
    navLabel="Other projects"
  />
</Base>

<style>
  /* ---- the column: the reading room's, text at 680 and media at 880 on one axis ---- */
  .room {
    --col: 680px;
    --media: 880px;
    --fs-read: clamp(1.1875rem, 1.1rem + 0.35vw, 1.3125rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .col { max-width: var(--col); margin-inline: auto; }

  /* ---- the header: back, the name at the ledger's size, his line, the slate ---- */
  .back { font-weight: 500; color: var(--ink-muted); }
  .back a:hover { color: var(--ink); }
  .name {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-size: clamp(2.25rem, 1.45rem + 2.7vw, 3.9rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  /* stopped and paused projects keep the ledger's grey, a little; the page is still in ink */
  .summary {
    margin-top: 0.85rem;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.55rem);
    line-height: 1.3;
    color: var(--ink-muted);
    font-optical-sizing: auto;
    text-wrap: pretty;
  }
  .why { margin-top: 0.5rem; color: var(--ink-muted); }
  .slate {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0;
    margin-top: 1.5rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
    font-weight: 500;
    color: var(--ink-muted);
    transition: border-color var(--d-relight) var(--ease-standard), color var(--d-relight) var(--ease-standard);
  }
  .slate > * + *::before { content: '·'; margin-inline: 0.5em; font-family: var(--sans); color: var(--ink-muted); }
  .slate .mono { font-size: inherit; }
  .status { color: var(--ink); white-space: nowrap; }
  .room:not([data-run]) .status { color: var(--ink-muted); }
  .tags { font-weight: 400; }

  /* the ledger's one dot: filled when running, a ring while building, grey when paused */
  .dot {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    margin-right: 0.5em;
    vertical-align: 0.05em;
    background: var(--status);
  }
  [data-status='building'] .dot { background: transparent; border: 1.5px solid var(--status); }
  [data-status='paused'] .dot { background: transparent; border: 1.5px solid var(--hairline-strong); }

  /* ---- the body: the reading room's type, his voice ---- */
  .body {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    max-width: var(--media);
    margin-inline: auto;
    font-family: var(--serif);
    font-size: var(--fs-read);
    font-weight: 480;
    line-height: 1.65;
    font-optical-sizing: auto;
    hanging-punctuation: first;
    overflow-wrap: break-word;
  }
  .body > :global(*) { max-width: var(--col); margin-inline: auto; }
  .body :global(p) { margin-block: 0 1.25em; text-wrap: pretty; }
  .body > :global(:last-child) { margin-block-end: 0; }
  .body :global(h2),
  .body :global(h3),
  .body :global(h4) {
    font-family: var(--sans);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-block: 2.2em 0.6em;
    text-wrap: pretty;
  }
  .body :global(h2) { font-size: 1.5rem; }
  .body :global(h3) { font-size: 1.25rem; }
  .body :global(h4) { font-size: 1.05rem; }
  .body :global(ul),
  .body :global(ol) { margin-block: 0 1.25em; padding-left: 1.5em; }
  .body :global(li + li) { margin-top: 0.4em; }
  .body :global(li::marker) { color: var(--ink-muted); }
  .body :global(li > p) { margin-block: 0 0.4em; }
  .body :global(blockquote) {
    margin-block: 1.5em;
    padding-left: 1.25em;
    border-left: 2px solid var(--accent);
    font-style: italic;
    transition: border-color var(--d-relight) var(--ease-standard);
  }
  .body :global(blockquote > :last-child) { margin-block-end: 0; }
  .body :global(a:hover) { text-decoration-color: var(--accent); }
  .body :global(img) { display: block; max-width: 100%; height: auto; margin-inline: auto; }
  .body > :global(p:has(> img:only-child)) { max-width: var(--media); margin-block: 1.75em; }
  .body :global(hr) {
    width: 64px;
    height: 0;
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--hairline-strong);
  }
  .body :global(sup) { font-size: 0.65em; line-height: 0; }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg-raised);
    padding: 0.08em 0.3em;
  }
  .body :global(pre) {
    margin-block: 0 1.25em;
    padding: 1em 1.25em;
    background: var(--bg-raised);
    overflow-x: auto;
    line-height: 1.5;
  }
  .body :global(pre code) { padding: 0; background: none; }

  /* ---- after the piece: small labels, no rules; the air does the dividing ---- */
  .label { font-weight: 500; color: var(--ink-muted); }

  /* links: the kind small on the left, the place on the right, one per line */
  .links { margin-top: var(--gap-block); }
  /* no piece yet: the links sit right under the slate, no gap posing as a missing body */
  .bare .links,
  .bare .stopped { margin-top: 2rem; }
  .links ul { margin-top: 0.75rem; display: grid; gap: 0.6rem; }
  .links li {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
  }
  .kind { color: var(--ink-muted); }
  .links a {
    font-size: var(--fs-lit);
    font-weight: 500;
    letter-spacing: -0.005em;
    overflow-wrap: anywhere;
  }
  .links a:hover { text-decoration-color: var(--accent); }
  .links a::after { content: ' →'; color: var(--ink-muted); font-weight: 400; }

  /* screenshots: wider than the text, a hairline frame so a dark page doesn't melt into the room */
  .examples { margin-top: var(--gap-block); display: grid; gap: var(--gap-block); }
  .shot { max-width: var(--media); width: 100%; margin: 0 auto; }
  .frame {
    border: 1px solid color-mix(in oklab, var(--ink) 18%, transparent);
    background: var(--bg-raised);
    line-height: 0;
  }
  .frame :global(img) { width: 100%; height: auto; }
  .shot figcaption {
    max-width: 560px;
    margin: 0.85rem auto 0;
    text-align: center;
    color: var(--ink-muted);
    text-wrap: pretty;
  }
  .shot .src { display: block; margin-top: 0.2rem; color: var(--ink-muted); }
  .shot .src:hover { color: var(--ink); }

  /* why it stopped: one line, in the reading voice, said once */
  .stopped { margin-top: var(--gap-block); }
  .stopped p {
    margin-top: 0.5rem;
    font-family: var(--serif);
    font-size: var(--fs-read);
    font-weight: 480;
    line-height: 1.55;
    font-optical-sizing: auto;
    text-wrap: pretty;
  }

  @media (max-width: 719px) {
    .room { padding-top: 1rem; }
    .name { margin-top: 1.5rem; }
    .links li { grid-template-columns: 3.75rem minmax(0, 1fr); gap: 0.75rem; }
  }
</style>
