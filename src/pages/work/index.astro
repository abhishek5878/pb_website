---
/**
 * Work: everything he has built, unfinished included (Q17: "I'm all the work").
 *
 * One dated ledger, newest first. The idea: status is saturation. What is
 * running (live, in use, building) is set large, in full ink, with the one
 * green dot; what stopped or paused is the same index in grey, smaller, still
 * dated, still here. Nothing is a card and nothing carries a tag row: the tags
 * filter once, at the top, as five groups. Without JavaScript every project
 * shows; with it a group filters in place and the hash keeps the filter. A
 * name links to its own page once the writer's entry for it exists.
 *
 * Every sentence is his, from src/data/me.ts.
 */
import Base from '../../layouts/Base.astro';
import { me, projects, proud, links } from '../../data/me';
import { sortedProjects, workEntries, pagePath, isRunning, whenISO, GROUPS, groupsOf } from './_work';

const sorted = sortedProjects();
const entries = await workEntries();
const total = projects.length;

/** Five groups, mapped from the tags in code (./_work.ts); a group nothing falls in stays hidden. */
const groups = GROUPS.map((g) => ({ ...g, n: projects.filter((p) => groupsOf(p).includes(g.id)).length })).filter((g) => g.n > 0);

/** A number as a graphic where his line gives one: "top 30 companies" → 30, with a label that says only what his line says. */
const numberIn = (line: string) => line.match(/top (\d+)/)?.[1];
const numberLabel: Record<string, string[]> = { 'My first internship, at an asset manager': ['top 30 companies,', 'US market, 1 year forward'] };
const proudHref: Record<string, string | undefined> = { 'WASP Signal': links.wasp };
---

<Base title="Work">
  <section class="wrap" aria-labelledby="work-label">
    <div class="label-row">
      <h1 id="work-label">Work</h1>
    </div>
    <p class="lead display obsession">{me.allTheWork}</p>
    <p class="stopped-note">{me.stopped}</p>

    <!-- The groups, once. Each is a plain link; JS makes it a filter. -->
    <nav class="tags" aria-label="Filter">
      <a href="#all" aria-current="true">All <span class="n mono">{total}</span></a>
      {groups.map((g) => (
        <a href={`#${g.id}`}>{g.label} <span class="n mono">{g.n}</span></a>
      ))}
      <span class="count small" id="count" aria-live="polite"></span>
    </nav>

    <ol class="index" id="index" role="list">
      {sorted.map((p, i) => {
        const run = isRunning(p);
        const showWhen = i === 0 || sorted[i - 1].when !== p.when;
        const page = entries.has(p.slug);
        return (
          <li
            class="row"
            id={p.slug}
            data-tags={groupsOf(p).join(' ')}
            data-status={p.status}
            data-run={run ? '' : undefined}
          >
            <div class="rail">
              <time class:list={['when', 'mono', { vh: !showWhen }]} datetime={whenISO(p.when)} data-when={p.when}>
                {p.when}
              </time>
              <p class="status">
                {(run || p.status === 'paused') && <span class="dot" aria-hidden="true"></span>}
                {p.status}
              </p>
            </div>
            <div class="what">
              <h2 class="name">
                {page ? (
                  <a href={pagePath(p.slug)}>{p.name}</a>
                ) : p.href ? (
                  <a href={p.href} rel="external">{p.name}</a>
                ) : (
                  p.name
                )}
              </h2>
              <p class="line">{p.line}</p>
              {p.why && <p class="why">{p.why}</p>}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <!-- His two proudest, in his words. The number is a graphic where his line gives one. -->
  <section class="section wrap" aria-labelledby="proud-label">
    <div class="label-row">
      <h2 id="proud-label">Proudest of</h2>
    </div>
    <div class="moments">
      {proud.map((p) => {
        const num = numberIn(p.line);
        const href = proudHref[p.name];
        return (
          <article class="moment grid">
            {num && (
              <div class="figure" aria-hidden="true">
                <p class="num">{num}</p>
                {numberLabel[p.name] && (
                  <p class="num-label small">{numberLabel[p.name].map((l) => <span>{l}</span>)}</p>
                )}
              </div>
            )}
            <div class="text">
              <p class="q">{p.line}</p>
              <p class="small who">
                <span class="name">{href ? <a href={href} rel="external">{p.name}</a> : p.name}</span>
                <span class="muted">{p.note}</span>
              </p>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section wrap exit">
    <p class="title">{me.oneMoreTime}</p>
  </section>
</Base>

<script>
  /* Filter in place by hash; the hash keeps the filter across reloads and links.
     No motion: a list filter is a frequent action. */
  const list = document.getElementById('index');
  const count = document.getElementById('count');
  const rows = list ? ([...list.querySelectorAll('li')] as HTMLLIElement[]) : [];
  const links = [...document.querySelectorAll<HTMLAnchorElement>('.tags a')];
  const known = new Set(links.map((a) => a.getAttribute('href')!.slice(1)));

  function apply() {
    let tag = decodeURIComponent(location.hash.slice(1));
    if (!known.has(tag)) tag = 'all';
    let n = 0;
    let last: string | undefined;
    for (const r of rows) {
      const on = tag === 'all' || (r.dataset.tags ?? '').split(' ').includes(tag);
      r.hidden = !on;
      if (!on) continue;
      n++;
      const t = r.querySelector<HTMLElement>('.when');
      if (t) {
        t.classList.toggle('vh', t.dataset.when === last);
        last = t.dataset.when;
      }
    }
    for (const a of links) {
      if (a.getAttribute('href') === '#' + tag) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    }
    if (count) count.textContent = tag === 'all' ? '' : `${n} of ${rows.length}`;
  }
  addEventListener('hashchange', apply);
  apply();
</script>

<style>
  .label-row h1,
  .label-row h2 {
    font-size: var(--fs-small);
    font-weight: 500;
    line-height: 1.45;
  }
  .obsession { max-width: 24ch; }
  .stopped-note { margin: 1.5rem 0 0; max-width: 34em; color: var(--ink-muted); }

  /* the tags, once */
  .tags {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.5rem;
    margin-top: var(--gap-block);
    font-size: var(--fs-small);
    font-weight: 500;
  }
  .tags a {
    color: var(--ink-muted);
    text-decoration: none;
    text-underline-offset: 0.3em;
    transition: color var(--d-hover) var(--ease-hover);
  }
  .tags a:hover { color: var(--ink); }
  .tags a[aria-current] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-decoration-color: var(--accent);
  }
  .tags .n { color: var(--ink-muted); font-weight: 400; }
  .tags a[aria-current] .n { color: var(--ink); }
  .count { color: var(--ink-muted); margin-left: auto; }

  /* the ledger: date, the thing, its status. rows are grids; no dividers */
  .index { margin-top: var(--gap-block); }
  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: baseline;
    padding-block: 0.6rem;
  }
  .row[data-run] { padding-block: 1.75rem; }
  .row[data-run] + .row:not([data-run]) { padding-top: 1.25rem; }
  .row:not([data-run]) + .row[data-run] { margin-top: 1rem; }
  .row[hidden] { display: none; }
  /* back from a project page (/work/#slug): the row lands with air above it */
  .row { scroll-margin-top: clamp(4rem, 12vh, 8rem); }
  /* the left rail is the slate: the date, and beneath it the status, said plainly */
  .rail { grid-column: 1 / 3; display: grid; gap: 0.3rem; }
  .when { color: var(--ink-muted); }
  .what { grid-column: 3 / 12; }
  .status {
    font-size: var(--fs-small);
    font-weight: 500;
    color: var(--ink-muted);
    white-space: nowrap;
  }
  .row[data-run] .status { color: var(--ink); }

  /* the grey timeline: stopped, paused, shipped */
  .name {
    font-size: clamp(1.375rem, 1.2rem + 0.75vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.015em;
    color: var(--ink-muted);
  }
  /* every name opens its page: the underline is there, but only just, so 23 of them don't stripe the ledger */
  .name a { text-decoration-color: var(--hairline); text-decoration-thickness: 1px; text-underline-offset: 0.12em; }
  .name a:hover { text-decoration-color: currentColor; }
  .line {
    margin-top: 0.3rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
    max-width: 44em;
  }
  .row[data-status='shipped'] .name,
  .row[data-status='shipped'] .line { color: var(--ink); }

  /* the colour flashes: live, in use, building */
  .row[data-run] .name {
    font-size: clamp(2.25rem, 1.45rem + 2.7vw, 3.9rem);
    font-weight: 700;
    line-height: 0.96;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .row[data-run] .line {
    margin-top: 0.75rem;
    font-size: var(--fs-body);
    color: var(--ink);
    max-width: 34em;
  }
  .why {
    margin-top: 0.35rem;
    font-size: var(--fs-small);
    color: var(--ink-muted);
  }

  /* the one dot: filled when running, a ring while building, grey when paused */
  .dot {
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    margin-right: 0.5em;
    vertical-align: 0.05em;
    background: var(--status);
  }
  .row[data-status='building'] .dot { background: transparent; border: 1.5px solid var(--status); }
  .row[data-status='paused'] .dot { background: transparent; border: 1.5px solid var(--hairline-strong); }

  @media (max-width: 719px) {
    .row {
      grid-template-columns: 1fr;
      row-gap: 0.25rem;
      padding-block: 0.9rem;
    }
    .row[data-run] { padding-block: 1.5rem; }
    .rail { grid-column: 1; display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
    .what { grid-column: 1; }
    .when.vh {
      position: static;
      width: auto;
      height: auto;
      clip: auto;
      visibility: hidden;
    }
    .tags { gap: 0.4rem 1.1rem; }
    .count { margin-left: 0; flex-basis: 100%; }
  }

  /* proudest of: the number in the slot, his line beside it, the name and his note beneath */
  .moments { margin-top: var(--gap-block); display: grid; row-gap: var(--gap-block); }
  .moment { align-items: start; }
  .moment .figure { grid-column: 1 / 4; }
  .moment .num {
    font-size: var(--fs-display-xl);
    font-weight: 700;
    line-height: 0.85;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    margin-top: -0.04em;
  }
  /* the number's label: what the 30 counts, in his line's own terms; small, under the figure */
  .moment .num-label {
    margin-top: 0.9rem;
    color: var(--ink-muted);
    font-weight: 500;
  }
  .moment .num-label span { display: block; white-space: nowrap; }
  .moment .text { grid-column: 4 / 12; }
  .moment .q {
    font-family: var(--serif);
    font-size: var(--fs-title);
    font-weight: 300;
    line-height: 1.2;
    font-optical-sizing: auto;
    max-width: 26em;
    text-wrap: pretty;
  }
  .who { margin-top: 1rem; display: flex; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .who .name { font-size: var(--fs-small); font-weight: 500; color: var(--ink); letter-spacing: 0; }
  @media (max-width: 719px) {
    .moment .figure { grid-column: 1 / -1; margin-bottom: 1rem; }
    .moment .num { font-size: clamp(4rem, 3rem + 6vw, 6rem); }
    .moment .num-label { margin-top: 0.5rem; }
    .moment .text { grid-column: 1 / -1; }
  }

  .exit .title { max-width: 27ch; }
</style>
