---
/**
 * The reading room: one local post. docs/design/reading.md is the spec.
 *
 * One centred column for every kind of post, now and later: his text at 680px,
 * left-aligned inside it; media may widen to 880px on the same axis; photo rolls
 * to 1200px. Substack's grammar (back link, title, subtitle, byline, hairline,
 * the piece), the site's own type and light. The body is his text, untouched.
 *
 * The room is lit by the piece: a poem's `light` is the page's rest light (Base
 * renders it on <html>); essays rest in the site's. One pull line returns after
 * the piece as a full-screen coda, nav hidden.
 */
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import type { ImageMetadata } from 'astro';
import Photos from '../../components/writing/Photos.astro';
import Embed from '../../components/writing/Embed.astro';
import { embedsOf, posterFor, posterPath } from '../../components/writing/posters';
import { hostLabel, isLocalAudio } from '../../components/writing/embeds';
import { stars } from '../../lib/media';
import { me } from '../../data/me';
import { getWriting, label, fmtDate, iso, homeOf, LANE_LABEL, type Post } from '../../lib/posts';
import { cardPath, cardAlt, shareDescription } from '../../lib/og/post';
import Ending from '../../components/Ending.astro';
import { threadsOf, mentionsOf, changedOn, after } from '../../lib/endings';

export async function getStaticPaths() {
  const local = (await getWriting()).filter((p) => p.source === 'site');
  /* Newer and older walk the post's own section (Writing, Books, Making); in Writing, its own
     lane (night, signal, build) when it has one. */
  return local.map((post) => {
    const home = homeOf(post).href;
    const mine = local.filter((p) => homeOf(p).href === home);
    const walk = post.lane && home === '/writing/' ? mine.filter((p) => p.lane === post.lane) : mine;
    const i = walk.indexOf(post);
    return { params: { id: post.id }, props: { post, newer: walk[i - 1] ?? null, older: walk[i + 1] ?? null } };
  });
}

interface Props { post: Post; newer: Post | null; older: Post | null }
const { post, newer, older } = Astro.props;
const entry = post.raw!;
const home = homeOf(post);
/* Where it was first published (Substack, WASP Signal). Credited at the foot of the piece;
   the canonical URL is this page, so vyas.garden is the post's home. */
const firstPublished = entry.data.canonical;
const pull = post.pull[0];
const isPoem = post.kind === 'poem';
/* A poem in Hindi, or in Hindi and English: the verse (and its coda) carry lang="hi", so
   Tiro Devanagari Hindi sets the Devanagari and a screen reader reads it as Hindi. */
const lang = entry.data.lang;
const hindi = lang === 'hi' || lang === 'mixed';
const devanagari = (s?: string) => !!s && /[\u0900-\u097F]/.test(s);

/* "N min read": words ÷ 230, rounded, never under 1. Markup and image syntax don't count. */
const words = (entry.body ?? '')
  .replace(/<!--[\s\S]*?-->/g, ' ')
  .replace(/<[^>]+>/g, ' ')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .split(/\s+/)
  .filter((w) => /[\p{L}\p{N}]/u.test(w)).length;
const minutes = Math.max(1, Math.round(words / 230));

/**
 * Verse: the markdown gives one <p> with his line breaks as <br>. Wrap each
 * authored line in a span so a wrapped line hangs and his break stays his.
 * The text itself is not touched; everything else renders as Astro would.
 */
function verseLines(html: string): string {
  return html.replace(/<div class="verse">([\s\S]*?)<\/div>/g, (_, inner: string) => {
    const lined = inner.replace(/<p>([\s\S]*?)<\/p>/g, (_m, p: string) =>
      '<p>' + p.split(/<br\s*\/?>\n?/).map((l) => `<span class="l">${l}</span>`).join('\n') + '</p>'
    );
    return `<div class="verse">${lined}</div>`;
  });
}
const verseHtml = (h: string) => (hindi ? h.replace(/<div class="verse">/g, '<div class="verse" lang="hi">') : h);
const html = isPoem && entry.rendered?.html ? verseHtml(verseLines(entry.rendered.html)) : null;
const { Content } = html ? { Content: null } : await render(entry);

/* PHOTOS (trips, photo rolls): src/components/writing/Photos.astro. The lead photo
   sits under the byline, the roll after his words. Local images only; a Letterboxd
   poster is a string and skipped. */
const photos = post.images.filter((i): i is { src: ImageMetadata; alt: string } => typeof i.src !== 'string');
const hasPhotos = photos.length > 0;

/* BOOKS (docs/design/making.md, Amendment 1 B): the title, the author beneath it, then status and
   rating in the byline; the highlights (the author's words) as quotes; then his notes. No covers. */
const isBook = post.kind === 'book';
const BOOK_STATUS: Record<string, string> = { reading: 'Reading now', read: 'Finished', stopped: 'Stopped' };
const bookStatus = isBook && entry.data.status ? BOOK_STATUS[entry.data.status] : undefined;
const highlights = isBook ? entry.data.highlights.filter((l) => l.trim()) : [];
const hasNotes = words > 0;

/* An untitled poem goes by its first line (Amendment 1): the outline, the tab and the card say it. */
const decode = (s: string) =>
  s
    .replace(/<[^>]+>/g, '')
    .replace(/&#x([0-9a-f]+);/gi, (_, x) => String.fromCodePoint(parseInt(x, 16)))
    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
    .replace(/&quot;/g, '"')
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
    .replace(/&amp;/g, '&')
    .trim();
const firstVerse = isPoem && !post.title && html ? decode(/<span class="l">([\s\S]*?)<\/span>/.exec(html)?.[1] ?? '') || undefined : undefined;
const name = post.title ?? firstVerse ?? label(post);

/* A note has no title and needs none: the piece starts under the byline. The h1 stays for readers of the outline. */
const heading = post.title ?? (isBook ? post.subject : post.subject ? label(post) : undefined);

/* VIDEO and MUSIC: the post's players (src/components/writing/Embed.astro), each behind a
   click-to-load facade. The first one's still is this site's own, fetched at build
   (/writing/<id>/poster.jpg). A link the site can't play stays a quiet link. */
const embeds = embedsOf(entry.data);
const firstPoster = embeds[0] ? await posterFor(embeds[0]) : null;
const playTitle = heading ?? name;
const localAudio = entry.data.audio && isLocalAudio(entry.data.audio) ? entry.data.audio : null;
const listenOut = entry.data.audio && !localAudio && !embeds.some((e) => e.shape === 'audio' || (e.provider === 'youtube' && !entry.data.youtube)) ? entry.data.audio : null;
const watchOut = post.kind === 'video' && !entry.data.youtube && entry.data.link && !embeds.length ? entry.data.link : null;
/* a link post: where it points, under the byline */
const linkOut = (post.kind === 'link' || isBook) && entry.data.link ? entry.data.link : null;
const linkText = (u: string) => u.replace(/^https?:\/\/(www\.)?/i, '').replace(/[?#].*$/, '').replace(/\/$/, '');
/* "N min read" says nothing under a photo, a video or a mix with a line or two */
const media = hasPhotos || embeds.length > 0 || !!localAudio;
const showMinutes = !isBook && !(media && words < 120);

/* ---- the end (src/components/Ending.astro): the thread, who links here, the dates, the lane's pair ---- */
const threads = await threadsOf({ post: post.id });
const mentions = await mentionsOf({ post });
/* changed: the last day his words changed after the post landed here (git; left out when git can't say) */
const changed = changedOn(entry.filePath);
const modified = after(changed, post.date) ? changed : undefined;
const neighbour = (p: Post | null) => (p ? { title: label(p), href: p.href, date: fmtDate(p.date), datetime: iso(p.date) } : null);

/* For agents: the piece as a BlogPosting, with dateModified where git knows it. */
const SITE = 'https://vyas.garden';
const article = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: name,
  ...(post.subtitle ? { alternativeHeadline: post.subtitle } : {}),
  url: new URL(post.href, SITE).href,
  mainEntityOfPage: new URL(post.href, SITE).href,
  datePublished: iso(post.date),
  ...(modified ? { dateModified: iso(modified) } : {}),
  wordCount: words,
  inLanguage: lang === 'hi' ? 'hi' : 'en',
  image: new URL(cardPath(post), SITE).href,
  author: { '@type': 'Person', name: me.fullName, url: SITE + '/' },
  ...(firstPublished ? { isBasedOn: firstPublished } : {}),
  ...(post.lane ? { articleSection: LANE_LABEL[post.lane] } : {}),
};
---

<Base
  title={name}
  description={shareDescription(post)}
  image={cardPath(post)}
  imageAlt={cardAlt(post)}
  light={post.light}
  section={home.href}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(article)} />
  <article class:list={['wrap room', isPoem ? 'poem' : 'essay', { photos: hasPhotos, book: isBook }]}>
    <header class="head col">
      <p class="back small"><a href={home.href} class="quiet">{home.label}</a></p>
      {heading ? <h1 class="title" lang={hindi && devanagari(heading) ? 'hi' : undefined}>{heading}</h1> : <h1 class="vh" lang={hindi && devanagari(name) ? 'hi' : undefined}>{name}</h1>}
      {post.subtitle && <p class="subtitle" lang={hindi && devanagari(post.subtitle) ? 'hi' : undefined}>{post.subtitle}</p>}
      {isBook && post.by && <p class="subtitle author">{post.by}{post.year ? <>, <span class="mono">{post.year}</span></> : null}</p>}
      <p class="byline small muted">
        <span class="who">{me.name}</span>
        {post.place && <span class="place">{post.place}</span>}
        {bookStatus && <span class="status">{bookStatus}</span>}
        {isBook && typeof post.rating === 'number' && (
          <span class="rating"><span aria-hidden="true">{stars(post.rating)}</span><span class="vh">{post.rating} out of 5</span></span>
        )}
        <time class="mono" datetime={iso(post.date)}>{fmtDate(post.date)}</time>
        {showMinutes && <span class="mins"><span class="mono">{minutes}</span> min read</span>}
      </p>
    </header>

    <!-- VIDEO / MUSIC: the players, each behind its facade (Embed.astro) -->
    {embeds.length > 0 && (
      <div class="players">
        {embeds.map((e, i) => (
          <Embed embed={e} title={playTitle} poster={i === 0 && firstPoster ? posterPath(post.id) : null} />
        ))}
      </div>
    )}
    {localAudio && (
      <div class="players col">
        <audio controls preload="none" src={localAudio}></audio>
      </div>
    )}
    {(listenOut || watchOut || linkOut) && (
      <p class="out col">
        {listenOut && <a href={listenOut} rel="external noopener">Listen on {hostLabel(listenOut)} →</a>}
        {watchOut && <a href={watchOut} rel="external noopener">Watch on {hostLabel(watchOut)} →</a>}
        {linkOut && <a href={linkOut} rel="external noopener">{linkText(linkOut)} →</a>}
      </p>
    )}

    <!-- PHOTOS: the lead photo (Photos.astro) -->
    {hasPhotos && <Photos photos={photos} part="lead" />}

    <div class="body wide" lang={!isPoem && hindi ? 'hi' : undefined}>
      {highlights.map((l) => (
        <blockquote class="highlight"><p>{l}</p></blockquote>
      ))}
      {highlights.length > 0 && hasNotes && <hr />}
      {html ? <Fragment set:html={html} /> : Content && <Content />}
    </div>

    <!-- PHOTOS: the rest of the roll (Photos.astro) -->
    {hasPhotos && <Photos photos={photos} part="roll" />}

    {firstPublished && (
      <p class="first small col">
        <a href={firstPublished} class="quiet" rel="external">First published on {post.sourceName ?? 'Substack'}</a>
      </p>
    )}
  </article>

  <!-- The coda: one of his lines, full screen. relight.js hides the nav, moves the
       lamp to the line's edge and, on leaving, returns the room to its rest light. -->
  {pull && (
    <section class="interlude" aria-label="From the piece" data-interlude data-light={post.light}>
      <div class="wrap grid">
        <blockquote class="verse-line" lang={hindi && devanagari(pull) ? 'hi' : undefined}><p>{pull}</p></blockquote>
      </div>
    </section>
  )}

  <Ending
    written={post.date}
    changed={modified}
    threads={threads}
    mentions={mentions}
    newer={neighbour(newer)}
    older={neighbour(older)}
    group={post.lane ? ` in ${LANE_LABEL[post.lane]}` : undefined}
    navLabel="Other pieces"
  />
</Base>

<style>
  /* ---- the column: text at 680, media at 880, both centred on one axis ---- */
  .room {
    --col: 680px;
    --media: 880px;
    --fs-read: clamp(1.1875rem, 1.1rem + 0.35vw, 1.3125rem);
    padding-top: clamp(1.5rem, 3vw, 2.5rem);
  }
  .col { max-width: var(--col); margin-inline: auto; }
  .wide { max-width: var(--media); margin-inline: auto; }

  /* ---- the header: back link, title, subtitle, byline, one hairline ---- */
  .back { font-weight: 500; color: var(--ink-muted); }
  .back a:hover { color: var(--ink); }
  .title {
    margin-top: clamp(2rem, 4vw, 3rem);
    font-family: var(--sans);
    font-size: clamp(2rem, 1.4rem + 2.4vw, 3rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.02em;
    text-wrap: pretty;
  }
  .poem .title {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    line-height: 1.12;
    letter-spacing: 0;
    font-optical-sizing: auto;
  }
  .subtitle {
    margin-top: 0.5rem;
    font-family: var(--serif);
    font-style: italic;
    font-weight: 300;
    font-size: clamp(1.2rem, 1.05rem + 0.5vw, 1.35rem);
    line-height: 1.35;
    color: var(--ink-muted);
    font-optical-sizing: auto;
    text-wrap: pretty;
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0;
    margin-top: 1.25rem;
    transition: border-color var(--d-relight) var(--ease-standard);
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--hairline);
    font-weight: 500;
  }
  .byline > * + *::before { content: '·'; margin-inline: 0.45em; font-family: var(--sans); }
  .byline .mono { font-size: inherit; }
  /* an untitled note: the byline sits where the title would */
  .head > .vh + .byline { margin-top: clamp(2rem, 4vw, 3rem); }
  .byline .mins .mono { margin-right: 0.3em; }

  /* ---- the body: Newsreader 480, 19 → 21px, 1.65, his text untouched ---- */
  .body {
    margin-top: clamp(1.5rem, 2.5vw, 2rem);
    font-family: var(--serif);
    font-size: var(--fs-read);
    font-weight: 480;
    line-height: 1.65;
    font-optical-sizing: auto;
    hanging-punctuation: first;
    overflow-wrap: break-word;
  }
  /* PHOTOS: with a lead photo above it, the words get a block's air (the photos' own CSS is in Photos.astro) */
  .photos .body { margin-top: var(--gap-block); }

  /* VIDEO / MUSIC: the players sit where a lead photo would, on the same axis (their CSS is in Embed.astro) */
  .players { margin-top: clamp(1.5rem, 3vw, 2.5rem); display: grid; gap: 1.5rem; }
  .players audio { width: 100%; }
  .players + .body,
  .out + .body { margin-top: clamp(2rem, 3.5vw, 3rem); }
  .out {
    margin-top: clamp(1.25rem, 2.5vw, 1.75rem);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: var(--fs-small);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .out a:hover { text-decoration-color: var(--accent); }
  .players + .out { margin-top: 1rem; }

  /* Hindi: Devanagari from Tiro Devanagari Hindi (fonts.css loads it only when a page has
     Devanagari); Latin stays Newsreader, so a mixed poem keeps one voice */
  .title:lang(hi),
  .subtitle:lang(hi),
  .body :global(:lang(hi)),
  .interlude .verse-line:lang(hi) p {
    font-family: 'Newsreader Variable', 'Newsreader', 'Tiro Devanagari Hindi', 'Mukta', Georgia, serif;
  }
  .body :global(.verse:lang(hi)) { line-height: 1.75; }

  /* BOOKS: the author under the title, status and rating in the byline, highlights as quotes */
  .author { font-style: normal; }
  .author .mono { font-size: 0.8em; }
  .byline .rating { letter-spacing: 0.08em; }
  .body .highlight { white-space: pre-line; }
  .body .highlight + .highlight { margin-top: 1.75em; }
  .book .body > .highlight:first-child { margin-top: 0; }

  /* every block of text sits in the 680 column; only media widens */
  .body > :global(*) { max-width: var(--col); margin-inline: auto; }
  .body :global(p) { margin-block: 0 1.25em; text-wrap: pretty; }
  .body > :global(:last-child) { margin-block-end: 0; }

  .body :global(h1),
  .body :global(h2),
  .body :global(h3),
  .body :global(h4),
  .body :global(h5),
  .body :global(h6) {
    font-family: var(--sans);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-block: 2.2em 0.6em;
    text-wrap: pretty;
  }
  .body :global(h1),
  .body :global(h2) { font-size: 1.5rem; }
  .body :global(h3) { font-size: 1.25rem; }
  .body :global(h4),
  .body :global(h5),
  .body :global(h6) { font-size: 1.05rem; }

  .body :global(ul),
  .body :global(ol) { margin-block: 0 1.25em; padding-left: 1.5em; }
  .body :global(li + li) { margin-top: 0.4em; }
  .body :global(li::marker) { color: var(--ink-muted); }
  .body :global(li > p) { margin-block: 0 0.4em; }
  .body :global(li > p:last-child) { margin-block-end: 0; }
  /* a nested list is part of its item */
  .body :global(li > ul),
  .body :global(li > ol) { margin-block: 0.4em 0; }

  /* a quote: the room's accent as a rule on the left, so it relights */
  .body :global(blockquote) {
    margin-block: 1.5em;
    padding-left: 1.25em;
    border-left: 2px solid var(--accent);
    font-style: italic;
    transition: border-color var(--d-relight) var(--ease-standard);
  }
  .body :global(blockquote > :last-child) { margin-block-end: 0; }

  /* links: ink with the site's hairline underline; the underline takes the accent on hover */
  .body :global(a:hover) { text-decoration-color: var(--accent); }

  /* images and video: centred, wide, no radius, no shadow; a portrait never taller than the screen */
  .body :global(img),
  .body :global(video) {
    display: block;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 90svh;
    margin-inline: auto;
    border-radius: 0;
  }
  .body :global(video) { width: 100%; max-height: none; background: var(--bg-raised); }
  .body > :global(p:has(> img:only-child)),
  .body > :global(p:has(> video:only-child)),
  .body > :global(figure) { max-width: var(--media); margin-block: 1.75em; }
  .body > :global(p:has(> img:only-child):has(+ .caption)),
  .body > :global(p:has(> video:only-child):has(+ .caption)) { margin-block-end: 0; }
  /* inside a list item (the "Nothing pays…" post): full item width, close to its line */
  .body :global(li p:has(> img:only-child)),
  .body :global(li p:has(> video:only-child)) { margin-block: 0.6em 0.4em; }

  /* captions: centred under the image, small Switzer, muted */
  .body :global(.caption) {
    max-width: 560px;
    margin-block: 0.75em 1.75em;
    font-family: var(--sans);
    font-size: var(--fs-small);
    font-weight: 400;
    line-height: 1.45;
    text-align: center;
    color: var(--ink-muted);
    transition: color var(--d-relight) var(--ease-standard);
  }

  /* a rule: short, centred */
  .body :global(hr) {
    width: 64px;
    height: 0;
    margin-block: 2.5em;
    border: 0;
    border-top: 1px solid var(--hairline-strong);
  }

  .body :global(sup) { font-size: 0.65em; line-height: 0; }
  .body :global(sub) { font-size: 0.65em; line-height: 0; }
  .body :global(code) {
    font-family: var(--mono);
    font-size: 0.9em;
    background: var(--bg-raised);
    padding: 0.08em 0.3em;
  }
  .body :global(pre) {
    margin-block: 0 1.25em;
    padding: 1em 1.25em;
    background: var(--bg-raised);
    overflow-x: auto;
    line-height: 1.5;
  }
  .body :global(pre code) { padding: 0; background: none; }
  .body :global(table) { display: block; overflow-x: auto; border-collapse: collapse; font-size: 0.9em; }
  .body :global(th),
  .body :global(td) { padding: 0.4em 0.8em; border-bottom: 1px solid var(--hairline); text-align: left; }
  .body :global(iframe) { display: block; width: 100%; max-width: var(--media); margin-inline: auto; }

  /* ---- verse: the same column; a wrapped line hangs; his breaks stay his ---- */
  .poem .body :global(.verse) { max-width: min(var(--col), 34em); }
  .poem .body :global(.verse p) { margin-block: 0; text-wrap: initial; }
  .poem .body :global(.verse p + p) { margin-top: 1.6em; }
  .poem .body :global(.l) {
    display: block;
    padding-left: 1.5em;
    text-indent: -1.5em;
    hanging-punctuation: first;
  }
  .poem .body :global(.indent) { display: inline-block; width: 2em; }

  /* ---- the end: where it was first published, then the coda, then newer / older ---- */
  .first {
    margin-top: var(--gap-block);
    text-align: center;
    color: var(--ink-muted);
  }
  .first a:hover { color: var(--ink); }

  /* the coda: the homepage interlude, the line alone */
  .interlude {
    min-height: 100svh;
    display: grid;
    align-content: center;
    margin-top: var(--gap-section);
    padding-block: var(--gap-block);
  }
  .interlude .verse-line { grid-column: 2 / 12; }
  .interlude .verse-line p {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 1.5rem + 3.6vw, 4.75rem);
    font-weight: 300;
    line-height: 1.1;
    letter-spacing: -0.01em;
    font-optical-sizing: auto;
    hanging-punctuation: first;
    max-width: 16em;
    text-wrap: balance;
  }
  html[data-js] .interlude .verse-line { opacity: 0; transition: opacity var(--d-reveal) var(--ease-out); }
  html[data-js] .interlude[data-on] .verse-line { opacity: 1; }

  /* phone: no dead gaps; the coda sits in the flow with air, not a screen */
  @media (max-width: 719px) {
    .room { padding-top: 1rem; }
    .title { margin-top: 1.5rem; }
    .body > :global(p:has(> img:only-child)),
    .body > :global(p:has(> video:only-child)),
    .body > :global(figure) { margin-block: 1.5em; }
    .interlude .verse-line { grid-column: 1 / -1; }
