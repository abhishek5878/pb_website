---
/**
 * Trips as a logbook: the place large, the post's title under it, the date in
 * mono, and the first photograph small beside it. The whole row opens the post.
 */
import { Image } from 'astro:assets';
import { fmtDate, iso, label } from '../../../lib/posts';
import type { Trip } from '../_making';

interface Props {
  trips: Trip[];
}
const { trips } = Astro.props;
const items = trips.map((t) => ({ ...t, title: t.post.title ?? label(t.post) }));
---

<ol class="trips" role="list">
  {items.map((t) => (
    <li class:list={['trip', { 'no-photo': !t.first }]}>
      {t.first && (
        <Image class="thumb" src={t.first.src} alt={t.first.alt} widths={[200, 320, 480]} sizes="(max-width: 719px) 96px, 200px" loading="lazy" decoding="async" />
      )}
      <div class="what">
        {t.place && <p class="place">{t.place}</p>}
        <p class="t"><a href={t.post.href} class="quiet">{t.title}</a></p>
      </div>
      <time class="d mono" datetime={iso(t.post.date)}>{fmtDate(t.post.date)}</time>
    </li>
  ))}
</ol>

<style>
  .trips { display: grid; gap: clamp(1.5rem, 2.5vw, 2.25rem); max-width: 64rem; }
  .trip {
    position: relative;
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    column-gap: clamp(1.25rem, 3vw, 3rem);
    align-items: center;
  }
  .trip.no-photo { grid-template-columns: minmax(0, 1fr) auto; }
  .thumb {
    width: 200px;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    background: var(--bg-raised);
  }
  .place {
    font-size: var(--fs-title);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .t { margin-top: 0.35rem; font-family: var(--serif); font-size: var(--fs-lit); font-weight: 300; line-height: 1.35; }
  .place + .t { color: var(--ink-muted); }
  .t a::after { content: ''; position: absolute; inset: 0; }
  .t a:focus-visible { outline: none; }
  .trip:has(.t a:focus-visible) { outline: 2px solid var(--accent); outline-offset: 6px; }
  .trip:hover .t a { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em; color: var(--ink); }
  .d { color: var(--ink-muted); }
  @media (max-width: 719px) {
    .trip { grid-template-columns: 96px minmax(0, 1fr); column-gap: 1rem; align-items: start; }
    .trip.no-photo { grid-template-columns: minmax(0, 1fr); }
    .thumb { width: 96px; }
    .place { font-size: 1.375rem; }
    .d { grid-column: 2; padding-top: 0.35rem; font-size: 0.8125rem; }
    .no-photo .d { grid-column: 1; }
  }
</style>
