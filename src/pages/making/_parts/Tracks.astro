---
/**
 * Music as a tracklist: the number, the title, who made it, the kind, the
 * date, and "Listen →" to the post (where the player waits behind a click).
 * The whole row is the way in; "Listen →" carries the link.
 */
import { fmtDate, iso } from '../../../lib/posts';
import type { Track } from '../_making';

interface Props {
  music: Track[];
}
const { music } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class="tracks" role="list">
  {music.map((m, i) => (
    <li class="track">
      <span class="i mono" aria-hidden="true">{pad(i + 1)}</span>
      <p class="what">
        <span class="t">{m.title}</span>
        {m.by && <span class="by">{m.by}</span>}
      </p>
      <span class="meta">
        <span class="k small">{m.kind}</span>
        <time class="d mono" datetime={iso(m.post.date)}>{fmtDate(m.post.date)}</time>
      </span>
      <a href={m.post.href} class="go small">Listen<span class="vh">: {m.title}{m.by ? `, ${m.by}` : ''}</span> →</a>
    </li>
  ))}
</ol>

<style>
  .tracks { display: grid; grid-template-columns: 3rem minmax(0, 1fr) auto auto auto; column-gap: clamp(1rem, 2.5vw, 2.5rem); max-width: 64rem; }
  .track {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-block: 0.85rem;
  }
  .meta { display: contents; }
  .i { color: var(--ink-muted); }
  .what { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.9rem; min-width: 0; }
  .t { font-size: var(--fs-lit); font-weight: 600; letter-spacing: -0.01em; line-height: 1.25; }
  .by { font-family: var(--serif); font-size: var(--fs-lit); font-weight: 300; font-style: italic; color: var(--ink-muted); }
  .k { color: var(--ink-muted); font-weight: 500; }
  .d { color: var(--ink-muted); }
  .go { font-weight: 500; text-decoration-color: var(--accent); white-space: nowrap; }
  /* the row is the way in */
  .go::after { content: ''; position: absolute; inset: 0; }
  .track:hover .t { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.18em; text-decoration-color: var(--hairline-strong); }
  .track:hover .go { text-decoration-color: currentColor; }
  .go:focus-visible { outline: none; }
  .track:has(.go:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  /* phone: the title and the way in on one line, the kind and the date under the title */
  @media (max-width: 719px) {
    .tracks { grid-template-columns: 2rem minmax(0, 1fr) auto; column-gap: 0.75rem; }
    .track { grid-template-areas: 'i what go' '. meta meta'; row-gap: 0.25rem; padding-block: 0.7rem; }
    .i { grid-area: i; }
    .what { grid-area: what; }
    .go { grid-area: go; }
    .meta { grid-area: meta; display: flex; flex-wrap: wrap; gap: 0 0.9rem; align-items: baseline; }
  }
</style>
