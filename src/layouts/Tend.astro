---
/**
 * The slim layout for /tend: the site's head and light, the mark, no public
 * nav, no footer, noindex. Ships lit by La La Land like the rest; picking a
 * light in the editor relights this room too (tend.js sets data-light).
 *
 * On a phone it installs as an app ("Add to Home Screen"): the manifest is
 * scoped to /tend/ (public/tend-manifest.webmanifest), the icon is his mark,
 * and it opens full screen in the room's dark. No service worker: nothing
 * of the room is ever cached, and /tend itself is sent no-store.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/light.css';
import '../styles/tend.css';
import Mark from '../components/Mark.astro';

interface Props { title?: string }
const { title = 'Tend' } = Astro.props;
---

<!doctype html>
<html lang="en" data-hour="day" data-light="lalaland">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title} · Abhishek</title>
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#0A1328" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- the app on his phone: a manifest scoped to /tend/, his mark as the icon -->
    <link rel="manifest" href="/tend-manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/tend-icon-180.png" />
    <meta name="application-name" content="tend" />
    <meta name="apple-mobile-web-app-title" content="tend" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="preload" href="/fonts/switzer/Switzer-Variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <div class="glow on" id="glow-a" aria-hidden="true"></div>
    <header class="top">
      <div class="wrap row">
        <a href="/" class="mark quiet" aria-label="Abhishek, home"><Mark /></a>
        <slot name="top" />
      </div>
    </header>
    <main id="main" class="wrap tend-main">
      <slot />
    </main>
  </body>
</html>
