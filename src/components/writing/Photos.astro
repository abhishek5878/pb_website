---
/**
 * Photographs in a post (trips, photo rolls), from the post's `images`
 * frontmatter. Two parts, because his words sit between them:
 *
 *   <Photos photos={photos} part="lead" />   the first photo, large, under the byline
 *   <Photos photos={photos} part="roll" />   the rest, one per row, after his words
 *
 * Every photo is centred on the reading column's axis (docs/design/reading.md):
 * up to 1200px wide, never taller than the screen, its `alt` as a caption
 * centred beneath. Local images only: sharp makes the sizes at build.
 * Self-contained (own CSS), so the reading room around it can be re-set
 * without touching this.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  photos: { src: ImageMetadata; alt: string }[];
  part: 'lead' | 'roll';
}
const { photos, part } = Astro.props;
const [lead, ...roll] = photos;

const WIDTHS = [480, 800, 1200, 1600, 2400];
const SIZES = '(max-width: 719px) 100vw, (max-width: 1304px) 92vw, 1200px';
---

{part === 'lead' && lead && (
  <figure class="photo lead-photo" style={`--w: ${lead.src.width}px`}>
    <Image src={lead.src} alt={lead.alt} widths={WIDTHS} sizes={SIZES} loading="eager" fetchpriority="high" decoding="async" />
    {lead.alt && <figcaption class="small muted">{lead.alt}</figcaption>}
  </figure>
)}

{part === 'roll' && roll.length > 0 && (
  <div class="roll">
    {roll.map((p) => (
      <figure class="photo" style={`--w: ${p.src.width}px`}>
        <Image src={p.src} alt={p.alt} widths={WIDTHS} sizes={SIZES} loading="lazy" decoding="async" />
        {p.alt && <figcaption class="small muted">{p.alt}</figcaption>}
      </figure>
    ))}
  </div>
)}

<style>
  /* wide, centred on the column's axis; captions centred beneath; no radius, no border */
  .photo { max-width: 1200px; margin: 0 auto; }
  .lead-photo { margin-top: clamp(1.5rem, 3vw, 2.5rem); }
  /* as wide as the frame, never taller than the screen (a portrait stays a portrait, centred),
     never wider than the file itself (--w: with a srcset the browser would lay it out at the `sizes` width) */
  .photo img {
    width: auto;
    max-width: min(100%, var(--w, 100%));
    height: auto;
    max-height: 88svh;
    margin-inline: auto;
    background: var(--bg-raised);
  }
  .photo figcaption {
    max-width: 560px;
    margin: 0.75rem auto 0;
    text-align: center;
    text-wrap: pretty;
  }
  .roll { display: grid; row-gap: var(--gap-block); margin-top: var(--gap-block); }
  @media (max-width: 719px) {
    .roll { row-gap: 2.5rem; }
    /* near full-bleed: half a rem from the screen's edge; the caption keeps the text margin */
    .photo { margin-inline: calc(0.5rem - var(--margin)); }
    .photo figcaption { padding-inline: calc(var(--margin) - 0.5rem); }
    .lead-photo { margin-top: 1.5rem; }
  }
</style>
